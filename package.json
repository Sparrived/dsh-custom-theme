{
  "name": "dsh-custom-theme",
  "version": "0.7.0",
  "description": "User-editable CSS themes and background images for the DSH Web GUI and Desktop app, with pickers in Settings",
  "license": "MIT",
  "author": "Sparrived",
  "type": "module",
  "main": "./src/index.mjs",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sparrived/dsh-custom-theme.git"
  },
  "bugs": {
    "url": "https://github.com/Sparrived/dsh-custom-theme/issues"
  },
  "homepage": "https://github.com/Sparrived/dsh-custom-theme#readme",
  "exports": {
    ".": "./src/index.mjs",
    "./themes": "./src/themes/index.mjs",
    "./themes/package.json": "./src/themes/package.json",
    "./themes/locale/*.json": "./src/themes/locale/*.json",
    "./backgrounds": "./src/backgrounds/index.mjs",
    "./backgrounds/package.json": "./src/backgrounds/package.json",
    "./backgrounds/locale/*.json": "./src/backgrounds/locale/*.json",
    "./appearance": "./src/appearance/index.mjs",
    "./appearance/package.json": "./src/appearance/package.json",
    "./appearance/locale/*.json": "./src/appearance/locale/*.json",
    "./reasoning": "./src/reasoning/index.mjs",
    "./reasoning/package.json": "./src/reasoning/package.json",
    "./reasoning/locale/*.json": "./src/reasoning/locale/*.json",
    "./effort": "./src/effort/index.mjs",
    "./effort/package.json": "./src/effort/package.json",
    "./effort/locale/*.json": "./src/effort/locale/*.json",
    "./working": "./src/working/index.mjs",
    "./working/package.json": "./src/working/package.json",
    "./working/locale/*.json": "./src/working/locale/*.json",
    "./branding": "./src/branding/index.mjs",
    "./branding/package.json": "./src/branding/package.json",
    "./branding/locale/*.json": "./src/branding/locale/*.json",
    "./injections": "./src/injections/index.mjs",
    "./injections/package.json": "./src/injections/package.json",
    "./injections/locale/*.json": "./src/injections/locale/*.json",
    "./tray": "./src/tray/index.mjs",
    "./tray/package.json": "./src/tray/package.json",
    "./tray/locale/*.json": "./src/tray/locale/*.json",
    "./locale/*.json": "./locale/*.json",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "src",
    "lib/client.js",
    "themes",
    "icon.svg",
    "locale",
    "cordis.patch.yml",
    "ARCHITECTURE.md",
    "docs/desktop-tray.md",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "test:tray-ui": "node test/browser/tray-popup.mjs",
    "test:popover": "node test/browser/popover-stacking.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:browser": "node test/browser/appearance.mjs",
    "test:effects": "node test/browser/working-effects.mjs",
    "test:slider": "node test/browser/slider-scope.mjs",
    "test:working": "node test/browser/working-row.mjs"
  },
  "keywords": [
    "dsh",
    "cordis",
    "plugin",
    "theme"
  ]
}
